<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- The one and only thing that drags in Chromium. No common ZGF project references this
         project, so an app that never adds it pays zero Chromium bytes / zero build cost.
         CefGlue.Common transitively pulls the matching per-RID chromiumembeddedframework.runtime.*
         packages, copied next to the consuming app's output. -->
    <ItemGroup>
        <PackageReference Include="CefGlue.Common" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ZGF.Gui\ZGF.Gui.csproj" />
        <ProjectReference Include="..\ZGF.Gui.Desktop\ZGF.Gui.Desktop.csproj" />
        <ProjectReference Include="..\ZGF.Desktop\ZGF.Desktop.csproj" />
    </ItemGroup>

    <!-- Builds the zgf-cef-helper subprocess exe and stages it as transitive copy-local content
         under cef-helper/, so any app that references this project gets the helper in its own
         bin/.../cef-helper/ with no csproj work of its own. Kept in build/ (Pack'd) so a future
         NuGet publish auto-imports the same logic. See the file for the cycle-free design. -->
    <Import Project="build\ZGF.WebView.Cef.targets" />

    <ItemGroup>
        <None Include="build\ZGF.WebView.Cef.targets" Pack="true" PackagePath="build\" />
    </ItemGroup>

</Project>
