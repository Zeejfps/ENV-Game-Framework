{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ILSpy icon theme",
  "description": "An icon theme: what each icon draws, a glyph of a font or an SVG picture. Its colors come from the color theme. Comments and trailing commas are allowed. The file's name without .json is the theme's id.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "The schema icon theme files follow.",
      "type": "string"
    },
    "name": {
      "description": "The name the icon theme is listed by: one for every language, or one per language tag, such as en or pt-BR, where English stands in for a language without one.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "extends": {
      "description": "The id of a built-in or user icon theme to build on; what this theme leaves out comes from it, and what no theme sets from lucide.",
      "type": "string"
    },
    "fonts": {
      "description": "TrueType or OpenType font files by id, for icons to name. A path is relative to this file and must stay inside its folder. The fonts of the themes extended, and lucide's font, lucide, can be named too; declaring one's id again draws its icons in this font.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "icons": {
      "description": "What each icon draws. Those left out come from the theme extended, else from lucide.",
      "type": "object",
      "additionalProperties": false,
