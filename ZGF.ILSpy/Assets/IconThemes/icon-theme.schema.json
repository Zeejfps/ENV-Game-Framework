  "definitions": {
    "icon": {
      "oneOf": [
        {
          "description": "A glyph of a font.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "font",
            "glyph"
          ],
          "properties": {
            "font": {
              "description": "The id of a font in fonts.",
              "type": "string"
            },
            "glyph": {
              "description": "The glyph's codepoint in hex digits, such as E0F2.",
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{1,6}$"
            }
          }
        },
        {
          "description": "An SVG picture. One that uses currentColor is drawn in the icon's color; one that does not keeps its own colors.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "svg"
          ],
          "properties": {
            "svg": {
              "description": "The SVG file, relative to this file and inside its folder.",
              "type": "string"
            }
          }
        }
      ]
    }
  }
