<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PublishAot>true</PublishAot>
        <OutputType Condition="'$(_IsPublishing)' == 'true'">WinExe</OutputType>
        <ApplicationIcon>Assets\Icon\app.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ZGF.Gui.Immediate\ZGF.Gui.Immediate.csproj" />
      <ProjectReference Include="..\ZGF.Gui.Immediate.Widgets\ZGF.Gui.Immediate.Widgets.csproj" />
      <ProjectReference Include="..\ZGF.ILSpy.Core\ZGF.ILSpy.Core.csproj" />
      <ProjectReference Include="..\ZGF.Gui.Generator\ZGF.Gui.Generator.csproj"
                        OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Localization\Strings\*.json" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ZGF.ILSpy.App.Tests" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Assets\Fonts\**\*.ttf" />
      <EmbeddedResource Include="Assets\Fonts\**\*.ttf">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\Icon\app_icon.rgba">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <Content Include="Assets\Fonts\**\LICENSE-*.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>licenses\%(Filename)%(Extension)</TargetPath>
      </Content>
    </ItemGroup>

</Project>
