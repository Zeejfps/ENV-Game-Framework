<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ICSharpCode.Decompiler" />
      <PackageReference Include="ICSharpCode.BamlDecompiler" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="LICENSE-ILSpy.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>licenses\LICENSE-ILSpy.txt</TargetPath>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Diagrams\html\template.html;Diagrams\html\script.js;Diagrams\html\styles.css;Diagrams\html\ILSpy.ico">
        <LogicalName>diagram/%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\JpegSharp\JpegSharp.csproj" />
      <ProjectReference Include="..\PngSharp\PngSharp\PngSharp.csproj" />
      <ProjectReference Include="..\ZGF.Svg\ZGF.Svg.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ZGF.ILSpy.Tests" />
      <InternalsVisibleTo Include="ZGF.ILSpy.App.Tests" />
    </ItemGroup>

</Project>
