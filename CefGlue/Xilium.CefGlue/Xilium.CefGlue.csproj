<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fork of CefGlue's core managed binding (Xilium.CefGlue), regenerated for
       CEF 150 by ../generator (see that folder's README). The assembly name is
       kept as Xilium.CefGlue so the existing ZGF.WebView.Cef sources and our
       harness bind against the same public API surface — the eventual ZGF swap
       is a package/reference swap, not a rewrite. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Xilium.CefGlue</AssemblyName>
    <RootNamespace>Xilium.CefGlue</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The hand-written proxies and handlers mark what may be null with '?', which only means something with
         annotations on. Not 'enable': the generated interop is not annotated, and flow warnings across it would be
         noise. -->
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- CS1591: missing XML doc on generated interop; NU-style irrelevant here.
         CS8981: the interop class is named libcef, after the C library it binds, across generated and hand-written
         files alike; renaming it for a name C# may one day reserve is churn in code the generator owns. -->
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>
  </PropertyGroup>

  <!-- Wrapper/** (the CEF C++ wrapper) is not vendored; nothing else to remove.
       A single upstream-disabled source is kept out of the compile. -->
  <ItemGroup>
    <Compile Remove="Interop\Base\cef_string_t.disabled.cs" />
    <None Include="Interop\Base\cef_string_t.disabled.cs" />
  </ItemGroup>

</Project>
