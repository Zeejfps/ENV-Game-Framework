<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ZGF.ILSpy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\ZGF.ILSpy.Tests\Fixtures\Resources\*" LogicalName="%(Filename)%(Extension)" />
    <Compile Include="..\ZGF.ILSpy.Tests\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <None Include="..\ZGF.ILSpy.Tests\Fixtures\SampleApp\SampleApp.dll" Link="Fixtures\SampleApp\SampleApp.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ZGF.ILSpy.Tests\Fixtures\ApiDiff\Older\ApiDiffSample.dll" Link="Fixtures\ApiDiff\Older\ApiDiffSample.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\ZGF.ILSpy.Tests\Fixtures\ApiDiff\Newer\ApiDiffSample.dll" Link="Fixtures\ApiDiff\Newer\ApiDiffSample.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZGF.ILSpy\ZGF.ILSpy.csproj" />
    <ProjectReference Include="..\ZGF.ILSpy.Core\ZGF.ILSpy.Core.csproj" />
    <ProjectReference Include="..\ZGF.Gui.Immediate.Testing\ZGF.Gui.Immediate.Testing.csproj" />
  </ItemGroup>

</Project>
