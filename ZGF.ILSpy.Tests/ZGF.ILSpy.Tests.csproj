<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\Resources\*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\SampleApp\**" />
    <None Remove="Fixtures\SampleApp\**" />
    <None Include="Fixtures\SampleApp\SampleApp.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Fixtures\AvaloniaSample\**" />
    <None Remove="Fixtures\AvaloniaSample\**" />
    <None Include="Fixtures\AvaloniaSample\AvaloniaSample.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Fixtures\EmbeddedPdb\**" />
    <None Remove="Fixtures\EmbeddedPdb\**" />
    <None Include="Fixtures\EmbeddedPdb\EmbeddedPdb.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\WebCil\SampleApp.wasm" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Fixtures\ApiDiff\**" />
    <None Remove="Fixtures\ApiDiff\**" />
    <None Include="Fixtures\ApiDiff\Older\ApiDiffSample.dll" Link="Fixtures\ApiDiff\Older\ApiDiffSample.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\ApiDiff\Newer\ApiDiffSample.dll" Link="Fixtures\ApiDiff\Newer\ApiDiffSample.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZGF.ILSpy.Core\ZGF.ILSpy.Core.csproj" />
  </ItemGroup>

</Project>
