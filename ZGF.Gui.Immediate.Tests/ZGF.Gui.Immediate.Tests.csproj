<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- A background GC counts the unused rest of a thread's allocation context as allocated by it, so allocation tests would see bytes no code allocated (dotnet/runtime#134724). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ZGF.Gui.Immediate.Testing" />
    <Using Include="ZGF.Gui.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZGF.Gui.Immediate\ZGF.Gui.Immediate.csproj" />
    <ProjectReference Include="..\ZGF.Gui.Testing\ZGF.Gui.Testing.csproj" />
    <ProjectReference Include="..\ZGF.Gui.Immediate.Testing\ZGF.Gui.Immediate.Testing.csproj" />
    <ProjectReference Include="..\ZGF.Gui.Immediate.Widgets\ZGF.Gui.Immediate.Widgets.csproj" />
  </ItemGroup>

</Project>
